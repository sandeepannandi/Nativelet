{
  "expo": {
    "name": "Nativelet Showcase",
    "slug": "nativelet-showcase",
    "version": "0.1.0",
    "orientation": "portrait",
    "scheme": "nativelet-showcase",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true
    },
    "android": {},
    "web": {
      "bundler": "metro",
      "output": "static"
    },
    "plugins": [
      "expo-router",
      "@nativelet/glass-shatter-native"
    ],
    "experiments": {
      "tsconfigPaths": false
    }
  }
}
